<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<AnchorPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.farmfrenzy.controller.GameStageController"
            styleClass="game-root" stylesheets="@../css/style.css"
            prefWidth="800" prefHeight="600">

    <GridPane fx:id="farmGrid" gridLinesVisible="false" styleClass="game-grid"
              AnchorPane.leftAnchor="138" AnchorPane.topAnchor="188"
              maxWidth="-Infinity" maxHeight="-Infinity">
        <columnConstraints>
            <ColumnConstraints minWidth="84" prefWidth="84" maxWidth="84"/>
            <ColumnConstraints minWidth="84" prefWidth="84" maxWidth="84"/>
            <ColumnConstraints minWidth="84" prefWidth="84" maxWidth="84"/>
            <ColumnConstraints minWidth="84" prefWidth="84" maxWidth="84"/>
            <ColumnConstraints minWidth="84" prefWidth="84" maxWidth="84"/>
            <ColumnConstraints minWidth="84" prefWidth="84" maxWidth="84"/>
        </columnConstraints>
        <rowConstraints>
            <RowConstraints minHeight="62" prefHeight="62" maxHeight="62"/>
            <RowConstraints minHeight="62" prefHeight="62" maxHeight="62"/>
            <RowConstraints minHeight="62" prefHeight="62" maxHeight="62"/>
            <RowConstraints minHeight="62" prefHeight="62" maxHeight="62"/>
            <RowConstraints minHeight="62" prefHeight="62" maxHeight="62"/>
        </rowConstraints>
    </GridPane>

    <ImageView fx:id="machineImage" fitWidth="110" preserveRatio="true" pickOnBounds="true"
               styleClass="map-building" onMouseClicked="#onMachineClicked"
               AnchorPane.leftAnchor="8" AnchorPane.topAnchor="195">
        <image>
            <Image url="@../images/egg_powder_machine.png" requestedWidth="240" preserveRatio="true" smooth="true"/>
        </image>
    </ImageView>

    <ImageView fx:id="wellImage" fitWidth="108" preserveRatio="true" pickOnBounds="true"
               styleClass="map-building" onMouseClicked="#onWellClicked"
               AnchorPane.leftAnchor="668" AnchorPane.topAnchor="240">
        <image>
            <Image url="@../images/water_well.png" requestedWidth="216" preserveRatio="true" smooth="true"/>
        </image>
    </ImageView>

    <ImageView fx:id="warehouseImage" fitWidth="108" preserveRatio="true" pickOnBounds="true"
               styleClass="map-building" onMouseClicked="#onWarehouseClicked"
               AnchorPane.leftAnchor="320" AnchorPane.topAnchor="500">
        <image>
            <Image url="@../images/warehouse.png" requestedWidth="224" preserveRatio="true" smooth="true"/>
        </image>
    </ImageView>

    <HBox alignment="CENTER_LEFT" spacing="18" styleClass="hud-panel"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
        <Label fx:id="coinsLabel" text="Coins: 0" styleClass="hud-label">
            <graphic>
                <ImageView fitWidth="22" fitHeight="22" preserveRatio="true">
                    <image>
                        <Image url="@../images/coin.png" requestedWidth="44" requestedHeight="44" preserveRatio="true" smooth="true"/>
                    </image>
                </ImageView>
            </graphic>
        </Label>
        <Label fx:id="waterLabel" text="Water: 5 / 5" styleClass="hud-label">
            <graphic>
                <ImageView fitWidth="22" fitHeight="22" preserveRatio="true">
                    <image>
                        <Image url="@../images/water_drop.png" requestedWidth="44" requestedHeight="44" preserveRatio="true" smooth="true"/>
                    </image>
                </ImageView>
            </graphic>
        </Label>
        <Label fx:id="warehouseLabel" text="Warehouse: 0 / 50" styleClass="hud-label"/>
        <Label fx:id="timerLabel" text="Time: 0" styleClass="hud-label"/>
        <Button fx:id="buyChickenButton" text="Buy Chicken (50)" onAction="#onBuyChickenClicked" styleClass="hud-button"/>
        <Button fx:id="pauseButton" text="Pause" onAction="#onPauseClicked" styleClass="hud-button"/>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="20" styleClass="hud-strip"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="42">
        <Label fx:id="objectiveLabel" text="Objective: collect 100 coins" styleClass="hud-label"/>
        <Label fx:id="messageLabel" text="" styleClass="hud-label"/>
    </HBox>

</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.farmfrenzy.controller.LoginController"
      alignment="CENTER" spacing="18" styleClass="menu-root"
      stylesheets="@../css/style.css">
    <Label text="Farm Frenzy 2" styleClass="title-label"/>
    <Label text="Please login to continue" styleClass="info-label"/>
    <TextField fx:id="usernameField" promptText="Username" maxWidth="240"/>
    <PasswordField fx:id="passwordField" promptText="Password" maxWidth="240"/>
    <HBox alignment="CENTER" spacing="15">
        <Button fx:id="loginButton" text="Login" onAction="#onLogin" styleClass="control-button"/>
        <Button fx:id="registerButton" text="Register" onAction="#onRegister" styleClass="control-button"/>
    </HBox>
    <Label fx:id="messageLabel" text="" styleClass="info-label"/>
</VBox>
